<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <!-- Align with Odoo 18 sales_team/security/sales_team_security.xml; OpenUpgrade + noupdate
       can leave pre-18 domains on DB otherwise. -->
  <record id="sale_team_comp_rule" model="ir.rule">
    <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
  </record>
</odoo>
