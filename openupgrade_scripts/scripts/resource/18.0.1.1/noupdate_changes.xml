<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <!-- Align with Odoo 18 resource/security/resource_security.xml; OpenUpgrade + noupdate
       can leave pre-18 domains on DB otherwise. -->
  <record id="resource_resource_multi_company" model="ir.rule">
    <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
  </record>
  <record id="resource_calendar_leaves_rule_multi_company" model="ir.rule">
    <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
  </record>
  <record id="resource_calendar_std" model="resource.calendar">
    <field name="full_time_required_hours">40</field>
  </record>
</odoo>
